<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>powershellYK.FIDO2.PreviewSignKey</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.FIDO2.PreviewSignKey</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>CredentialID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RelyingPartyID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Algorithm</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>HashAlgorithm</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>PublicKey</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>KeyHandle</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>AttestationObject</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>ToBeSigned</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>DerivedPublicKey</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Signature</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>SignatureHex</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>powershellYK.FIDO2.PreviewSignKey</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.FIDO2.PreviewSignKey</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader>
            <Label>RelyingPartyID</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Algorithm</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>HashAlgorithm</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>CredentialID</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>KeyHandle</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>AttestationObject</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Signature</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>RelyingPartyID</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Algorithm</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>HashAlgorithm</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>CredentialID</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>KeyHandle</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>AttestationObject</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Signature</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>powershellYK.FIDO2.PreviewSignVerificationResult</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.FIDO2.PreviewSignVerificationResult</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>Valid</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>SignatureValid</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>DigestMatches</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>DerivedPublicKey</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>HashAlgorithm</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RelyingPartyID</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>AttestationDecoded</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>AttestationFormat</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>RpIdHashMatches</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Aaguid</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>UserPresence</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>UserVerification</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>SignatureCounter</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>AttestationStatementType</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Notes</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>powershellYK.PIV.SlotInfo</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.PIV.SlotInfo</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>Slot</PropertyName>
                <FormatString>0x{0:X}</FormatString>
              </ListItem>
              <ListItem>
                <PropertyName>KeyStatus</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>Algorithm</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>PinPolicy</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>TouchPolicy</PropertyName>
              </ListItem>
              <ListItem>
                <Label>Subjectname</Label>
                <ScriptBlock>$_.Certificate.SubjectName.Name</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>Issuer</Label>
                <ScriptBlock>$_.Certificate.IssuerName.Name</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>NotBefore</Label>
                <ScriptBlock>$_.Certificate.NotBefore</ScriptBlock>
              </ListItem>
              <ListItem>
                <Label>NotAfter</Label>
                <ScriptBlock>$_.Certificate.NotAfter</ScriptBlock>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>powershellYK.PIV.SlotInfo</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.PIV.SlotInfo</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader>
            <Label>Subjectname</Label>
            <Width>32</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>Issuer</Label>
            <Width>32</Width>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>NotBefore</Label>
          </TableColumnHeader>
          <TableColumnHeader>
            <Label>NotAfter</Label>
          </TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <PropertyName>Slot</PropertyName>
                <FormatString>0x{0:X}</FormatString>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>KeyStatus</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Algorithm</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>PinPolicy</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>TouchPolicy</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Certificate.SubjectName.Name</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Certificate.IssuerName.Name</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Certificate.NotBefore</ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.Certificate.NotAfter</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>powershellYK.Attestion</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.Attestion</TypeName>
      </ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem>
                <PropertyName>Slot</PropertyName>
                <FormatString>0x{0:X}</FormatString>
              </ListItem>
              <ListItem>
                <PropertyName>AttestionValidated</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>SerialNumber</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>FirmwareVersion</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>PinPolicy</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>TouchPolicy</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>FormFactor</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>isFIPSSeries</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>isCSPNSeries</PropertyName>
              </ListItem>
              <ListItem>
                <PropertyName>AttestionMatchesCSR</PropertyName>
              </ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>powershellYK.OATH.Codeget-</Name>
      <ViewSelectedBy>
        <TypeName>powershellYK.OATH.Code.TOTP</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader >
            <Label>
              Name
            </Label>
          </TableColumnHeader>
          <TableColumnHeader />
          <TableColumnHeader />
          <TableColumnHeader />
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem>
                <ScriptBlock>
                    $_.Issuer + " " + $_.AccountName
                </ScriptBlock>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>Value</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>validFrom</PropertyName>
              </TableColumnItem>
              <TableColumnItem>
                <PropertyName>validUntil</PropertyName>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>